{
  "_comment": "Real Elasticsearch design for the `restaurants` index (served by alias `restaurants` -> restaurants_vN). The app runs an in-memory adapter with the same behaviour; see ADR 0013.",
  "settings": {
    "number_of_shards": 1,
    "analysis": {
      "filter": {
        "autocomplete_ngram": { "type": "edge_ngram", "min_gram": 2, "max_gram": 15 }
      },
      "analyzer": {
        "folded": { "type": "custom", "tokenizer": "standard", "filter": ["lowercase", "asciifolding"] },
        "autocomplete": { "type": "custom", "tokenizer": "standard", "filter": ["lowercase", "asciifolding", "autocomplete_ngram"] }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "id":            { "type": "long" },
      "name":          { "type": "text", "analyzer": "folded",
                         "fields": { "keyword": { "type": "keyword" },
                                     "suggest": { "type": "text", "analyzer": "autocomplete", "search_analyzer": "folded" } } },
      "address":       { "type": "text", "analyzer": "folded" },
      "cuisine":       { "type": "keyword", "fields": { "text": { "type": "text", "analyzer": "folded" } } },
      "cityId":        { "type": "long" },
      "cityName":      { "type": "keyword" },
      "open":          { "type": "boolean" },
      "averageRating": { "type": "scaled_float", "scaling_factor": 10 },
      "ratingCount":   { "type": "integer" },
      "menu": {
        "type": "nested",
        "properties": {
          "id":        { "type": "long" },
          "name":      { "type": "text", "analyzer": "folded",
                         "fields": { "suggest": { "type": "text", "analyzer": "autocomplete", "search_analyzer": "folded" } } },
          "category":  { "type": "keyword" },
          "price":     { "type": "scaled_float", "scaling_factor": 100 },
          "veg":       { "type": "boolean" },
          "available": { "type": "boolean" }
        }
      }
    }
  }
}
